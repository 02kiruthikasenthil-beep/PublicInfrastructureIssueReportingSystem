# Copy to .env (never commit .env). Used by docker compose; for `mvn spring-boot:run` copy to backend/.env.
# Every variable is documented in README.md > Environment Variables.

# --- Database ---
DB_URL=jdbc:postgresql://localhost:5432/civic_issue
DB_USERNAME=postgres
DB_PASSWORD=change-me-db-password

# --- Security ---
# At least 32 characters. run.sh / run.bat generate one for you on first start.
JWT_SECRET=Xk9mPqR2vT8wZ4nL7cJ5hF1sD6gA3bY0eU9iO2pQ
JWT_EXPIRATION_MS=86400000
# Comma-separated browser origins allowed to call the API (your frontend URL in production)
CORS_ORIGINS=http://localhost:5173

# --- Optional demo accounts (created only when a password is set; leave blank in production) ---
SEED_OFFICER_EMAIL=officer@civicfix.local
SEED_OFFICER_PASSWORD=Officer@12345
SEED_ADMIN_EMAIL=admin@civicfix.local
SEED_ADMIN_PASSWORD=Admin@12345

# --- Third-party / optional ---
NOMINATIM_URL=https://nominatim.openstreetmap.org
GEO_USER_AGENT=CivicFix/0.2 (student project; contact: you@example.com)
# URL of the ML triage service (docker compose --profile ml up). Empty = rule-based triage only.
AI_ML_URL=

# --- Frontend build (Vite bakes this in at build time) ---
VITE_API_URL=http://localhost:8080/api
